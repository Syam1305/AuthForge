# AuthForge Environment Configuration

# PostgreSQL Connection String
DATABASE_URL="postgresql://postgres:authforge@localhost:5432/authforge?schema=public"

# Server Configuration
PORT=4000
NODE_ENV=development
TRUST_PROXY=1

# Security / CORS (comma-separated or single origin)
CORS_ORIGIN=http://localhost:3000,http://localhost:61661

# OTP & Secrets (Phase 3)
OTP_SECRET=authforge-default-otp-hmac-secret-phase3

# JWT & Token Configuration (Phase 4)
JWT_ACCESS_SECRET=replace_with_a_secure_minimum_32_character_jwt_secret_key!
ACCESS_TOKEN_ISSUER=authforge
ACCESS_TOKEN_AUDIENCE=authforge-api
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Account Security & Lockout Policy (Phase 5)
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
SECURITY_EVENT_RETENTION_DAYS=90

# Optional SMTP Email Delivery (Gmail / Custom SMTP)
# If not configured, AuthForge runs in Development OTP Mode (outputs OTPs to console & test store)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-account@gmail.com
# SMTP_PASSWORD=your-16-char-gmail-app-password
# SMTP_FROM="AuthForge <no-reply@authforge.dev>"

# SMS OTP Delivery Configuration
# Options: development | msg91 | twilio
# In development, AuthForge defaults to Development SMS Sandbox (outputs OTPs to console & local test store)
SMS_PROVIDER=development

# Option A: MSG91 Production Configuration (SendOTP V5 API)
# NOTE: These values belong ONLY in the AuthForge backend .env. NEVER expose them to client applications.
# MSG91_AUTH_KEY=your_msg91_auth_key_here
# MSG91_TEMPLATE_ID=your_dlt_approved_template_id
# Optional purpose-specific overrides (fall back to MSG91_TEMPLATE_ID if unset):
# MSG91_VERIFY_TEMPLATE_ID=
# MSG91_LOGIN_TEMPLATE_ID=
# MSG91_RESET_TEMPLATE_ID=

# Option B: Twilio Production Configuration
# SMS_API_KEY=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SMS_API_SECRET=your_twilio_auth_token
# SMS_FROM=+12055550199

# Google Authentication Configuration (Phase 10)
# Options: true | false
GOOGLE_AUTH_ENABLED=false
# Google Web Client ID from Google Cloud Console (APIs & Services > Credentials > OAuth 2.0 Client IDs)
# Example: 123456789012-abcdefghijklmnopqrstuvwxyz123456.apps.googleusercontent.com
# GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com


