# AuthForge Environment Configuration

# PostgreSQL Connection String
DATABASE_URL="postgresql://postgres:authforge@localhost:5432/authforge?schema=public"

# Server Configuration
PORT=4000
NODE_ENV=development
TRUST_PROXY=1

# Security / CORS (comma-separated or single origin)
CORS_ORIGIN=http://localhost:3000

# OTP & Secrets (Phase 3)
OTP_SECRET=authforge-default-otp-hmac-secret-phase3

# JWT & Token Configuration (Phase 4)
JWT_ACCESS_SECRET=replace_with_a_secure_minimum_32_character_jwt_secret_key!
ACCESS_TOKEN_ISSUER=authforge
ACCESS_TOKEN_AUDIENCE=authforge-api
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Account Security & Lockout Policy (Phase 5)
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
SECURITY_EVENT_RETENTION_DAYS=90
