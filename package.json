{
  "name": "authforge",
  "version": "1.0.0",
  "description": "AuthForge — Standalone Reusable Authentication Backend Service",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "rimraf dist && tsc",
    "start": "node dist/server.js",
    "test": "node --import tsx tests/google-auth.test.ts && node --import tsx tests/msg91-delivery.test.ts && node --import tsx tests/smtp-delivery.test.ts && node --import tsx tests/phone-auth.test.ts && node --import tsx tests/redteam-full-audit.ts && npm run test --prefix client/authforge-client && npm run test --prefix client/loginlab",
    "test:google": "node --import tsx tests/google-auth.test.ts",
    "test:msg91": "node --import tsx tests/msg91-delivery.test.ts",
    "test:smtp": "node --import tsx tests/smtp-delivery.test.ts",
    "test:phone": "node --import tsx tests/phone-auth.test.ts",
    "test:audit": "node --import tsx tests/redteam-full-audit.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "maintenance:cleanup": "node dist/scripts/cleanup.js"
  },
  "keywords": [
    "auth",
    "authentication",
    "authforge",
    "express",
    "prisma",
    "postgresql"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "argon2": "^0.45.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "google-auth-library": "^11.0.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "^1.13.12",
    "nodemailer": "^9.1.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.5",
    "@types/nodemailer": "^8.0.1",
    "prisma": "^6.4.1",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
